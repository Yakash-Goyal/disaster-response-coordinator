# ---------------------------------------------------------------
# Server configuration. Copy this file to ".env" and fill it in.
# ---------------------------------------------------------------

PORT=4000
# Address of the React app, allowed to call this API (CORS)
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL + PostGIS connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/drrc

# Secret used to sign login tokens. Use a long random string.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Google Gemini (Triage Agent). Get a free key at https://aistudio.google.com
# Leave GEMINI_API_KEY empty to use the built-in keyword classifier instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Routing engine (OSRM). Public demo server by default;
# point this at a self-hosted OSRM later without code changes.
OSRM_URL=https://router.project-osrm.org

# Geocoding (address -> coordinates) via OpenStreetMap Nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Deduplication: reports of the same type within this distance and time
# window are merged into one incident.
DEDUP_RADIUS_METERS=500
DEDUP_WINDOW_MINUTES=60

# Triage results below this confidence (0-1) are flagged for human review
TRIAGE_REVIEW_THRESHOLD=0.6

# Mock social-media feed: seconds between posts
SOCIAL_FEED_INTERVAL_SECONDS=5
