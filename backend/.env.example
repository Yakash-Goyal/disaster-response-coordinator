# ---------------------------------------------------------------------------
# Everything here is optional. With no .env file at all the system runs fully:
# SQLite database, heuristic agents, offline route estimator.
# Copy to .env and edit to switch any layer to its production backend.
# ---------------------------------------------------------------------------

# --- Agent intelligence ---------------------------------------------------
# Without a key the agents use their deterministic keyword/rule implementations.
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-6
# LLM_PROVIDER=auto            # auto | anthropic | heuristic

# --- Road routing ---------------------------------------------------------
# Blank uses the built-in estimator. Point at OSRM for real road geometry.
# OSRM_URL=http://localhost:5000
# OSRM_URL=https://router.project-osrm.org

# --- Database -------------------------------------------------------------
# Blank uses SQLite at backend/drc.db. A Postgres DSN activates PostGIS.
# DATABASE_URL=postgresql+psycopg://drc:drc@localhost:5432/drc

# --- Security -------------------------------------------------------------
# SECRET_KEY=change-this-before-you-demo-on-a-network

# --- Scenario location ----------------------------------------------------
# SCENARIO_CENTER_LAT=30.7333
# SCENARIO_CENTER_LNG=76.7794
# SCENARIO_RADIUS_KM=6.0

# --- Demo pacing ----------------------------------------------------------
# SIM_SPEED_MULTIPLIER=12       # 1 = real time; 12 compresses a 12 min drive to 1 min
# ORCHESTRATOR_TICK_SECONDS=4
# SOCIAL_FEED_ENABLED=true
# SOCIAL_FEED_INTERVAL_S=25
# WEATHER_FEED_ENABLED=true
# WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# --- Human-in-the-loop ----------------------------------------------------
# Leave off for the demo: every dispatch then requires commander approval.
# ALLOW_AUTO_APPROVE=false
# AUTO_APPROVE_MAX_SEVERITY=2
